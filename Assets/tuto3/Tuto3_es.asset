  m_TableData:
  - m_Id: 4100000000007
    m_Localized: "Ahora, hay otra cosa que deber\xEDas saber."
    m_Metadata:
      m_Items: []
  - m_Id: 4100000000008
    m_Localized: El Drifter.
    m_Metadata:
      m_Items: []
  - m_Id: 4100000000009
    m_Localized: "El Drifter es un bug que se mueve libremente por la cuadr\xEDcula,
      desplazando cosas a su paso."
    m_Metadata:
      m_Items: []
  - m_Id: 4100000000010
    m_Localized: "Cuando hace esto, amplifica el efecto del bug que ha movido, \xBFlo
      pillas?"
    m_Metadata:
      m_Items: []
  - m_Id: 4100000000011
    m_Localized: "Te conviene que se mantenga cerca de tus Wavebugs para que amplifique
      tu se\xF1al de forma natural."
    m_Metadata:
      m_Items: []
  - m_Id: 4100000000012
    m_Localized: "Si se acerca a esos otros peque\xF1os cretinos, corres el riesgo
      de que amplifique la interferencia de ruido. Y eso definitivamente no es bueno."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
