  m_TableData:
  - m_Id: 4200000000000
    m_Localized: " \xA1AAARGH! \xA1odio estos malditos tel\xE9fonos! \xA1ya le dije
      a control de misi\xF3n que los Pear Phones solo sirven para romperse, y mira
      lo que ha pasado! \xBFya es tarde para decir \u2018te lo dije\u2019?"
    m_Metadata:
      m_Items: []
  - m_Id: 4200000000001
    m_Localized: "oh, genial, \xA1esto es maravilloso! no solo estoy atrapado aqu\xED
      con lo peor del pelot\xF3n, \xA1sino que ahora ni siquiera puedo escuchar mis
      radionovelas en paz!"
    m_Metadata:
      m_Items: []
  - m_Id: 4200000000002
    m_Localized: "h-hola? no puedo o\xEDr a nadie\u2026 creo que los comunicadores
      est\xE1n rotos\u2026 o quiz\xE1 simplemente no quieres hablar conmigo\u2026
      \xA1\xA1y tambi\xE9n est\xE1 bien!! (supongo\u2026)"
    m_Metadata:
      m_Items: []
  - m_Id: 4200000000003
    m_Localized: '... '
    m_Metadata:
      m_Items: []
  - m_Id: 4200000000004
    m_Localized: "oh no\u2026 las torres de telefon\xEDa han ca\xEDdo\u2014\xA1ya
      est\xE1! \xA1estamos perdidos! \xA1se van a olvidar de m\xED aqu\xED fuera!
      \xA1ooohhh esto se acab\xF3!"
    m_Metadata:
      m_Items: []
  - m_Id: 4200000000005
    m_Localized: "oh, parece que se fue la luz o algo as\xED. bueno, seguro que todo
      est\xE1 bien y esto definitivamente no va a hacer que nadie entre en p\xE1nico!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
