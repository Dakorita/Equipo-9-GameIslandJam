  m_TableData:
  - m_Id: 4200000000000
    m_Localized: "AAARGH! i hate these cursed phones! i told mission control that
      all Pear Phones are good at is breaking, and look at what\u2019s happened!
      is it too late to say \u2018i told you so\u2019?"
    m_Metadata:
      m_Items: []
  - m_Id: 4200000000001
    m_Localized: oh great, isnt this just wonderful! not only am i stuck out here
      with the worst of the platoon, but now i cant even listen to my radio dramas
      in peace!
    m_Metadata:
      m_Items: []
  - m_Id: 4200000000002
    m_Localized: "h-hello? i cant hear anyone\u2026 i think maybe the communicators
      are broken\u2026 or maybe you just dont want to talk to me- which is ok too!!
      (i guess\u2026)"
    m_Metadata:
      m_Items: []
  - m_Id: 4200000000003
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 4200000000004
    m_Localized: "Oh no\u2026 the cell towers are down- thats it! were all doomed!
      theyre gonna forget about me out here! oohhh its so over!"
    m_Metadata:
      m_Items: []
  - m_Id: 4200000000005
    m_Localized: oh, looks like the power went out or something. oh well, im sure
      everything is fine and this is definitely not going to make anyone panic!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
